---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Sidebar from "../components/sidebar.astro";
---

<Layout title="Contact | Glen Meredith">
    <div class="flex h-screen">
        <Sidebar currentPage="contact" />

        <div class="flex-1 bg-white p-8 overflow-auto">
            <div id="content">
                <div class="max-w-4xl mx-auto py-16 px-6">
                    <!-- Title -->
                    <h1
                        class="text-6xl md:text-7xl font-black mb-8 leading-tight"
                    >
                        Contact
                    </h1>

                    <!-- Intro -->
                    <div class="mb-16">
                        <p class="text-2xl text-gray-700 leading-relaxed mb-6">
                            I'm actively seeking UX and product design
                            opportunities. Whether you have a role, a project,
                            or just want to chat about design—I'd love to hear
                            from you.
                        </p>
                    </div>

                    <!-- Contact Info -->
                    <div class="mb-16">
                        <h2 class="text-4xl font-bold mb-8">Get in Touch</h2>

                        <div class="space-y-6 text-lg">
                            <!-- Email -->
                            <div>
                                <p class="text-gray-600 mb-2">Email</p>
                                <a
                                    href="mailto:glen.lee.meredith@gmail.com"
                                    class="text-2xl font-bold text-green-600 hover:text-green-700 underline"
                                >
                                    glen.lee.meredith@gmail.com
                                </a>
                            </div>

                            <!-- LinkedIn -->
                            <div>
                                <p class="text-gray-600 mb-2">LinkedIn</p>
                                <a
                                    href="https://linkedin.com/in/glen-meredith"
                                    target="_blank"
                                    class="text-2xl font-bold text-green-600 hover:text-green-700 underline"
                                >
                                    linkedin.com/in/glen-meredith
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Resume Download -->
                    <div class="mb-16">
                        <h2 class="text-4xl font-bold mb-8">Resume</h2>
                        <p class="text-lg text-gray-700 mb-6">
                            Want the full picture? Download my resume for a
                            complete overview of my experience, education, and
                            skills.
                        </p>
<a 
    href="/glen-meredith-resume-2026.pdf" 
    download 
    class="inline-block bg-gradient-to-r from-[#10573d] to-[#064e3b] text-white px-8 py-4 rounded-lg font-bold text-lg hover:from-[#064e3b] hover:to-[#047857] transition shadow-lg"
>
                            Download my resume →
                        </a>
                    </div>

                    <!-- Availability -->
                    <div class="border-t border-gray-200 pt-12">
                        <h2 class="text-4xl font-bold mb-6">Availability</h2>
                        <div class="space-y-3 text-lg text-gray-700">
                            <p>
                                <strong>Location:</strong> Based in Utah, open to
                                remote, hybrid, in-person or relocation
                            </p>
                            <p>
                                <strong>Start Date:</strong> Available immediately
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script>
    // Scroll reveal observer
    const revealElements = document.querySelectorAll(".scroll-reveal");

    if (revealElements.length > 0) {
        const scrollObserver = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("revealed");
                    }
                });
            },
            {
                threshold: 0.1,
                rootMargin: "0px 0px -100px 0px",
            },
        );

        revealElements.forEach((el) => scrollObserver.observe(el));
    }
</script>
